`timescale 1ns / 1ps
module counttest(clk,rst,count);
	input clk,rst;
	output [7:0] count;
	
	
	control(clk,rst)
	cnt1(clk,rst,count1);
	cnt2(clk,rst,count2);


endmodule

module control(cnt1,cnt2,clk,rst,enable);
	input clk,rst,cnten1,cnten2;
	input [3:0]cnt1;
	input [7:0]cnt2;
	
	always@(posedge clk or posedge rst)begin
		if(rst)begin
			count<=cnt1;
		else if(cnten1==1)begin
			count<=cnt2;
		end
		else if(cnten2==1)begin
			count<=cnt1;
		end
		
	
	

module cnt1(clk,rst,count1,en);
	input clk,rst;
	output [3:0] count1;
	
	always@(posedge clk or posedge rst)begin
		if(rst)begin
			count1 <= 4'd0;
			en <= 0;
		end
		else if(count==4'd9)begin
			count1 <= 4'd0;
			en <= 1;
		end
		else begin
			count1<=count1+1;
		end
	end
endmodule

module cnt2(clk,rst,count2);
	input clk,rst;
	output [7:0] count2;
	
	always@(posedge clk or posedge rst)begin
		if(rst)begin
			count2 <= 4'hfd;
			en <= 0;
		end
		else if(count==4'h11)begin
			count1 <= 4'hfd;
			en <= 1;
		end
		else begin
			count1<=count1-1;
		end
	end
endmodule
